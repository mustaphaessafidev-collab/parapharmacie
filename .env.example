# This repository has no root application env file.
# Copy the example next to each app and fill it locally. Never commit those copies.
#
# Frontend: copy Frontend/.env.example to Frontend/.env
# Backend:  copy Backend/.env.example to Backend/.env
#
# Placeholder names only. Do not put real passwords, tokens, or database URLs here.

FRONTEND_EXAMPLE=Frontend/.env.example
BACKEND_EXAMPLE=Backend/.env.example
