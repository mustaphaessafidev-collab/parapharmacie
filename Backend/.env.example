PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/parapharmacie
JWT_SECRET=replace-with-a-long-random-string
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-smtp-password
EMAIL_FROM=AtlasPara <mailer@example.com>
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Used only by `npx prisma db seed`. The script refuses NODE_ENV=production.
SEED_ADMIN_PASSWORD=replace-with-a-local-password
SEED_CLIENT_PASSWORD=replace-with-a-local-password
SEED_LIVREUR_PASSWORD=replace-with-a-local-password
